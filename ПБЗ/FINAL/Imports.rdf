    <!-- http://www.w3.org/2002/07/owl#topObjectProperty -->

    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#topObjectProperty">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2#works_in"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2#ProductionRole"/>
            </owl:Restriction>
        </rdfs:domain>
    </rdf:Description>
    


