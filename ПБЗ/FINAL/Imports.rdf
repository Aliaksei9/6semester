    <!-- http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2-new#uses_playing_method -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2-new#uses_playing_method">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2#Crowd"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2#MainRoleActor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2#SecondaryRoleActor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/hollywood/ontologies/2026/1/hollywood-ontology#Actor"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
