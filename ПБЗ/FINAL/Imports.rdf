        <rdfs:range rdf:resource="http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2#DevelopmentPeriod"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2#followed_by -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2#followed_by">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2#DevelopmentPeriod"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2#DevelopmentPeriod"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/alsane/ontologies/2026/1/untitled-ontology-2#has_got_award -->

